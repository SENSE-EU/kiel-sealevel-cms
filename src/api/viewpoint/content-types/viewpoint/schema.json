{
  "kind": "collectionType",
  "collectionName": "viewpoints",
  "info": {
    "singularName": "viewpoint",
    "pluralName": "viewpoints",
    "displayName": "Viewpoint",
    "description": "A fixed camera position within a scene model"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "anchor": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "scene": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::scene.scene",
      "inversedBy": "viewpoints"
    }
  }
}
